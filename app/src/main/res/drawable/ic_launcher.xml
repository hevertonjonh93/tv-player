<?xml version="1.0" encoding="utf-8"?>
<!-- Ícone do app: quadrado arredondado roxo -> rosa com a TV/play -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <size android:width="96dp" android:height="96dp" />
            <gradient
                android:angle="315"
                android:endColor="@color/accent2"
                android:startColor="@color/accent" />
            <corners android:radius="24dp" />
        </shape>
    </item>
    <item
        android:bottom="10dp"
        android:drawable="@drawable/logo_mark"
        android:left="10dp"
        android:right="10dp"
        android:top="8dp" />
</layer-list>
