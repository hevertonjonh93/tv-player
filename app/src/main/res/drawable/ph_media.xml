<?xml version="1.0" encoding="utf-8"?>
<!-- Imagem padrão quando o item não tem logo/capa -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/panel_line" />
            <corners android:radius="6dp" />
        </shape>
    </item>
    <item
        android:bottom="6dp"
        android:drawable="@drawable/logo_mark"
        android:left="6dp"
        android:right="6dp"
        android:top="6dp" />
</layer-list>
