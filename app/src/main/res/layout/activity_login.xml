<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp">

        <LinearLayout
            android:id="@+id/loginBox"
            android:layout_width="480dp"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <ImageView
                android:layout_width="84dp"
                android:layout_height="84dp"
                android:layout_gravity="center_horizontal"
                android:contentDescription="Logo"
                android:src="@drawable/ic_launcher" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center"
                android:text="IPTV Player"
                android:textColor="@color/text"
                android:textSize="30sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="Canais · Filmes · Séries"
                android:textColor="@color/muted"
                android:textSize="15sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Tipo de login"
                android:textColor="@color/muted"
                android:textSize="16sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnModeXtream"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/tab_bg"
                    android:padding="12dp"
                    android:text="Xtream Codes"
                    android:textAllCaps="false"
                    android:textColor="@color/text"
                    android:textSize="16sp" />

                <Button
                    android:id="@+id/btnModeM3u"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/tab_bg"
                    android:padding="12dp"
                    android:text="Lista M3U / M3U8"
                    android:textAllCaps="false"
                    android:textColor="@color/text"
                    android:textSize="16sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/groupXtream"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <EditText
                    android:id="@+id/etServer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/input_bg"
                    android:hint="Servidor / DNS (ex: http://meuservidor.com:8080)"
                    android:imeOptions="actionNext"
                    android:inputType="textUri"
                    android:padding="14dp"
                    android:textColor="@color/text"
                    android:textColorHint="@color/muted"
                    android:textSize="18sp" />

                <EditText
                    android:id="@+id/etUser"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/input_bg"
                    android:hint="Usuário"
                    android:imeOptions="actionNext"
                    android:inputType="textNoSuggestions"
                    android:padding="14dp"
                    android:textColor="@color/text"
                    android:textColorHint="@color/muted"
                    android:textSize="18sp" />

                <EditText
                    android:id="@+id/etPass"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/input_bg"
                    android:hint="Senha"
                    android:imeOptions="actionDone"
                    android:inputType="textPassword"
                    android:padding="14dp"
                    android:textColor="@color/text"
                    android:textColorHint="@color/muted"
                    android:textSize="18sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/groupM3u"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <EditText
                    android:id="@+id/etM3u"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/input_bg"
                    android:hint="URL da lista (http://.../lista.m3u)"
                    android:imeOptions="actionDone"
                    android:inputType="textUri"
                    android:padding="14dp"
                    android:textColor="@color/text"
                    android:textColorHint="@color/muted"
                    android:textSize="18sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Aceita listas .m3u, .m3u8 e links get.php. Canais, filmes e séries são separados automaticamente."
                    android:textColor="@color/muted"
                    android:textSize="14sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvError"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:textColor="@color/error"
                android:textSize="16sp"
                android:visibility="gone" />

            <Button
                android:id="@+id/btnLogin"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:background="@drawable/row_bg"
                android:padding="14dp"
                android:text="Entrar"
                android:textColor="@color/text"
                android:textSize="18sp" />

            <ProgressBar
                android:id="@+id/progress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="16dp"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
